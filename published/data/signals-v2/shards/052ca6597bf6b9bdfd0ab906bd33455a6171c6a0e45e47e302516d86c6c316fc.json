roach, the classification is performed to axis from IRMA code instead of to assign the labels to all axes in one step like to first approach. The evaluating provides results to various measures for each iteration. These results are grouped by measure in individual files to that can get means and standard deviation from each iteration. The measures considered in",0,48,"2013-04-22T17:50:23.000Z",4,5,50,0,0,[],8,3,"villani/ml-medimage",2,2,0,0,0,0,"2013-04-29T21:58:04.000Z",null,null,""],["github:vlad36/clearcanvas",0,"vlad36/ClearCanvas","https://github.com/vlad36/ClearCanvas","Open source RIS/PACS and DICOM viewer",0,49,"2013-04-14T19:16:44.000Z",5,1,51,0,0,[],0,0,"vlad36/ClearCanvas",0,0,0,1,5,0,"2013-03-21T20:58:32.000Z",null,null,""],["github:wanderine/broccoli",0,"wanderine/BROCCOLI","https://github.com/wanderine/BROCCOLI","BROCCOLI: Software for Fast fMRI Analysis on Many-Core CPUs and GPUs",0,50,"2013-04-30T14:41:51.000Z",4,6,52,0,0,[],2,2,"wanderine/BROCCOLI",118,38,23,1,2,0,"2020-10-16T09:50:02.000Z",null,null,""],["github:washington-university/dcm_to_4dfp",0,"Washington-University/dcm_to_4dfp","https://github.com/Washington-University/dcm_to_4dfp","Convert DICOM files into 4dfp",0,51,"2013-04-18T20:23:59.000Z",10,1,53,0,0,[],0,0,"Washington-University/dcm_to_4dfp",0,0,0,0,1,0,"2013-04-19T20:10:51.000Z",null,null,""],["github:wzinke/myfia",0,"wzinke/myfia","https://github.com/wzinke/myfia","miscellaneous bash scripts to facilitate the processing and handling of fMRI data, primarily based on tools provided by the FSL package.",0,52,"2013-04-26T09:20:10.000Z",18,11,54,0,0,[],2,2,"wzinke/myfia",8,0,0,0,6,0,"2019-04-12T17:13:39.000Z",null,null,""]]}
